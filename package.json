{
  "name": "wize.io",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "article:new": "node scripts/article-new.mjs",
    "article:sync": "node scripts/article-registry.mjs",
    "article:check": "node scripts/article-registry.mjs --check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.6",
    "@sindresorhus/slugify": "3.0.1",
    "@types/mdx": "2.0.14",
    "clsx": "2.1.1",
    "motion": "13.4.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-syntax-highlighter": "16.1.1"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "nanoid": "6.0.1",
    "prettier": "3.9.9",
    "prettier-plugin-css-order": "2.2.0",
    "standard-version": "9.5.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@10.34.5",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
