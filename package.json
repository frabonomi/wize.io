{
  "name": "wize.io",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "release": "standard-version",
    "release:dry": "standard-version --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "motion": "13.4.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.9",
    "prettier-plugin-css-order": "2.2.0",
    "standard-version": "9.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@10.17.0",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": "prettier --write"
  }
}
